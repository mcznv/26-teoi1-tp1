package tp1;

import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.List;

parser code {:
    // Referencia compartida a la Tabla de Símbolos del Léxico
    public TablaSimbolos ts = new TablaSimbolos();

    // Lista de reglas sintácticas reconocidas para mostrar en la consola del IDE
    public List<String> reglasReconocidas = new ArrayList<>();

    // Lista de errores sintácticos y semánticos
    public List<String> erroresSintacticos = new ArrayList<>();

    // Listas auxiliares para emparejar [variables] ::= [tipos]
    ArrayList<String> tempVariables = new ArrayList<>();
    ArrayList<String> tempTipos = new ArrayList<>();

    private void registrarRegla(String regla) {
        reglasReconocidas.add("[REGLA SINTÁCTICA] " + regla);
    }

    @Override
    public void syntax_error(Symbol s) {
        String lexema = (s.value != null) ? s.value.toString() : "fin de archivo o símbolo";
        String error = "ERROR SINTÁCTICO en línea " + s.left + ", columna " + s.right +
                       ": Token inesperado '" + lexema + "'.";
        erroresSintacticos.add(error);
        System.err.println(error);
    }

    @Override
    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        String error = "ERROR SINTÁCTICO FATAL en línea " + s.left + ": No se pudo continuar con el análisis.";
        erroresSintacticos.add(error);
    }

    private void registrarErrorSemantico(int linea, String mensaje) {
        String error = "ERROR SEMÁNTICO en línea " + linea + ": " + mensaje;
        erroresSintacticos.add(error);
        System.err.println(error);
    }
:};

/* --- TERMINALES --- */
terminal DECLARE_SECTION, ENDDECLARE_SECTION, PROGRAM_SECTION, ENDPROGRAM_SECTION;
terminal FLOAT, INT, STRING;
terminal WHILE, ENDWHILE, IF, ELSE, ENDIF;
terminal WRITE;
terminal SETSWITCH, CASE, ELSECASE, ENDSETCASE;
terminal OP_AND, OP_OR;
terminal ASIGNACION;
terminal OP_SUMA, OP_RESTA, OP_MULT, OP_DIV;
terminal OP_MENOR, OP_MENOR_IGUAL, OP_MAYOR, OP_MAYOR_IGUAL, OP_IGUAL, OP_DISTINTO;
terminal COR_A, COR_C, PAR_A, PAR_C, COMA, DOS_PUNTOS;
terminal String ID;
terminal String CONST_INT;
terminal String CONST_REAL;
terminal String CONST_STRING;

/* --- NO TERMINALES --- */
non terminal programa, seccion_declaracion, seccion_programa;
non terminal lista_declaraciones, declaracion, lista_variables, lista_tipos;
non terminal String tipo_dato;
non terminal lista_sentencias, sentencia;
non terminal asignacion, condicional, bucle, salida_io, estructura_switch;
non terminal lista_casos, caso, caso_defecto;
non terminal String expresion, termino, factor;
non terminal expresion_logica, condicion;

/* --- PRECEDENCIA --- */
precedence left OP_OR;
precedence left OP_AND;
precedence left OP_IGUAL, OP_DISTINTO, OP_MENOR, OP_MENOR_IGUAL, OP_MAYOR, OP_MAYOR_IGUAL;
precedence left OP_SUMA, OP_RESTA;
precedence left OP_MULT, OP_DIV;

/* --- REGLAS GRAMATICALES --- */
start with programa;

programa ::=
    seccion_declaracion seccion_programa
    {: registrarRegla("programa -> seccion_declaracion seccion_programa (Programa general reconocido)"); :}
    ;

/* --- Sección de Declaraciones --- */
seccion_declaracion ::=
    DECLARE_SECTION lista_declaraciones ENDDECLARE_SECTION
    {: registrarRegla("seccion_declaracion -> DECLARE.SECTION lista_declaraciones ENDDECLARE.SECTION"); :}
    | /* vacío si es programa sin variables */
    ;

lista_declaraciones ::=
    lista_declaraciones declaracion
    | declaracion
    ;

declaracion ::=
    COR_A lista_variables COR_C ASIGNACION:asig COR_A lista_tipos COR_C
    {:
        if (tempVariables.size() != tempTipos.size()) {
            registrarErrorSemantico(asigleft, "La cantidad de variables (" + tempVariables.size() +
                                   ") no coincide con la cantidad de tipos (" + tempTipos.size() + ").");
        } else {
            for (int i = 0; i < tempVariables.size(); i++) {
                String nombreVar = tempVariables.get(i);
                String tipoVar = tempTipos.get(i);
                if (ts.existe(nombreVar)) {
                    registrarErrorSemantico(asigleft, "La variable '" + nombreVar + "' ya fue declarada previamente.");
                } else {
                    ts.agregar(nombreVar, "ID", tipoVar, "", 0);
                }
            }
            registrarRegla("declaracion -> " + tempVariables + " ::= " + tempTipos);
        }
        tempVariables.clear();
        tempTipos.clear();
    :}
    ;

lista_variables ::=
    lista_variables COMA ID:id
    {: tempVariables.add(id); :}
    | ID:id
    {: tempVariables.add(id); :}
    ;

lista_tipos ::=
    lista_tipos COMA tipo_dato:tipo
    {: tempTipos.add(tipo); :}
    | tipo_dato:tipo
    {: tempTipos.add(tipo); :}
    ;

tipo_dato ::=
    INT    {: RESULT = "Integer"; :}
    | FLOAT  {: RESULT = "Float"; :}
    | STRING {: RESULT = "String"; :}
    ;

/* --- Sección del Programa Principal --- */
seccion_programa ::=
    PROGRAM_SECTION lista_sentencias ENDPROGRAM_SECTION
    {: registrarRegla("seccion_programa -> PROGRAM.SECTION lista_sentencias ENDPROGRAM.SECTION"); :}
    ;

lista_sentencias ::=
    lista_sentencias sentencia
    | sentencia
    ;

sentencia ::=
    asignacion
    | condicional
    | bucle
    | salida_io
    | estructura_switch
    ;

/* Sentencia de Asignación */
asignacion ::=
    ID:id ASIGNACION:asig expresion:tipoExp
    {:
        if (!ts.existe(id)) {
            registrarErrorSemantico(idleft, "La variable '" + id + "' no fue declarada en DECLARE.SECTION.");
        } else {
            String tipoVar = ts.obtenerTipo(id);
            if ("String".equals(tipoVar) && !"String".equals(tipoExp)) {
                registrarErrorSemantico(asigleft, "Incompatibilidad de tipos: la variable String '" + id + "' solo puede recibir una constante string.");
            } else if (!"String".equals(tipoVar) && "String".equals(tipoExp)) {
                registrarErrorSemantico(asigleft, "Incompatibilidad de tipos: no se puede asignar un String a la variable numérica '" + id + "'.");
            }
        }
        registrarRegla("asignacion -> " + id + " ::= expresion");
    :}
    ;

/* Estructura de Control IF */
condicional ::=
    IF PAR_A expresion_logica PAR_C lista_sentencias ENDIF
    {: registrarRegla("condicional -> IF (expresion_logica) lista_sentencias ENDIF"); :}
    | IF PAR_A expresion_logica PAR_C lista_sentencias ELSE lista_sentencias ENDIF
    {: registrarRegla("condicional -> IF (expresion_logica) lista_sentencias ELSE lista_sentencias ENDIF"); :}
    ;

/* Estructura de Control WHILE */
bucle ::=
    WHILE PAR_A expresion_logica PAR_C lista_sentencias ENDWHILE
    {: registrarRegla("bucle -> WHILE (expresion_logica) lista_sentencias ENDWHILE"); :}
    ;

/* Impresión por pantalla */
salida_io ::=
    WRITE CONST_STRING:val
    {: registrarRegla("salida_io -> WRITE constante string (\"" + val + "\")"); :}
    | WRITE CONST_INT:val
    {: registrarRegla("salida_io -> WRITE constante entera (" + val + ")"); :}
    | WRITE CONST_REAL:val
    {: registrarRegla("salida_io -> WRITE constante real (" + val + ")"); :}
    | WRITE ID:id
    {:
        if (!ts.existe(id)) {
            registrarErrorSemantico(idleft, "La variable '" + id + "' en WRITE no fue declarada.");
        }
        registrarRegla("salida_io -> WRITE variable (" + id + ")");
    :}
    ;

/* Tema Especial Grupo 6: SETSWITCH */
estructura_switch ::=
    SETSWITCH PAR_A expresion:tipoExp PAR_C lista_casos caso_defecto ENDSETCASE
    {:
        if ("String".equals(tipoExp)) {
            registrarErrorSemantico(tipoExpleft, "La expresión de SETSWITCH debe arrojar un valor numérico.");
        }
        registrarRegla("estructura_switch -> SETSWITCH (expresion) lista_casos ELSECASE ENDSETCASE");
    :}
    | SETSWITCH PAR_A expresion:tipoExp PAR_C lista_casos ENDSETCASE
    {:
        if ("String".equals(tipoExp)) {
            registrarErrorSemantico(tipoExpleft, "La expresión de SETSWITCH debe arrojar un valor numérico.");
        }
        registrarRegla("estructura_switch -> SETSWITCH (expresion) lista_casos ENDSETCASE");
    :}
    ;

lista_casos ::=
    lista_casos caso
    | caso
    ;

caso ::=
    CASE CONST_INT:val DOS_PUNTOS lista_sentencias
    {: registrarRegla("caso -> CASE " + val + ": lista_sentencias"); :}
    ;

caso_defecto ::=
    ELSECASE DOS_PUNTOS lista_sentencias
    {: registrarRegla("caso_defecto -> ELSECASE: lista_sentencias"); :}
    ;

/* --- Expresiones Lógicas --- */
expresion_logica ::=
    condicion OP_AND condicion
    {: registrarRegla("expresion_logica -> condicion AND condicion"); :}
    | condicion OP_OR condicion
    {: registrarRegla("expresion_logica -> condicion OR condicion"); :}
    | condicion
    ;

condicion ::=
    expresion OP_MENOR expresion
    {: registrarRegla("condicion -> expresion < expresion"); :}
    | expresion OP_MENOR_IGUAL expresion
    {: registrarRegla("condicion -> expresion <= expresion"); :}
    | expresion OP_MAYOR expresion
    {: registrarRegla("condicion -> expresion > expresion"); :}
    | expresion OP_MAYOR_IGUAL expresion
    {: registrarRegla("condicion -> expresion >= expresion"); :}
    | expresion OP_IGUAL expresion
    {: registrarRegla("condicion -> expresion == expresion"); :}
    | expresion OP_DISTINTO expresion
    {: registrarRegla("condicion -> expresion != expresion"); :}
    | PAR_A expresion PAR_C
    ;

/* --- Expresiones Aritméticas --- */
expresion ::=
    expresion:e OP_SUMA:op termino:t
    {:
        if ("String".equals(e) || "String".equals(t)) {
            registrarErrorSemantico(opleft, "No se puede aplicar suma (+) sobre un tipo String.");
            RESULT = "ERROR";
        } else {
            RESULT = ("Float".equals(e) || "Float".equals(t)) ? "Float" : "Integer";
        }
        registrarRegla("expresion -> expresion + termino");
    :}
    | expresion:e OP_RESTA:op termino:t
    {:
        if ("String".equals(e) || "String".equals(t)) {
            registrarErrorSemantico(opleft, "No se puede aplicar resta (-) sobre un tipo String.");
            RESULT = "ERROR";
        } else {
            RESULT = ("Float".equals(e) || "Float".equals(t)) ? "Float" : "Integer";
        }
        registrarRegla("expresion -> expresion - termino");
    :}
    | termino:t
    {: RESULT = t; :}
    ;

termino ::=
    termino:t OP_MULT:op factor:f
    {:
        if ("String".equals(t) || "String".equals(f)) {
            registrarErrorSemantico(opleft, "No se puede aplicar multiplicación (*) sobre un tipo String.");
            RESULT = "ERROR";
        } else {
            RESULT = ("Float".equals(t) || "Float".equals(f)) ? "Float" : "Integer";
        }
        registrarRegla("termino -> termino * factor");
    :}
    | termino:t OP_DIV:op factor:f
    {:
        if ("String".equals(t) || "String".equals(f)) {
            registrarErrorSemantico(opleft, "No se puede aplicar división (/) sobre un tipo String.");
            RESULT = "ERROR";
        } else {
            RESULT = ("Float".equals(t) || "Float".equals(f)) ? "Float" : "Integer";
        }
        registrarRegla("termino -> termino / factor");
    :}
    | factor:f
    {: RESULT = f; :}
    ;

factor ::=
    ID:id
    {:
        if (!ts.existe(id)) {
            registrarErrorSemantico(idleft, "La variable '" + id + "' no fue declarada en DECLARE.SECTION.");
            RESULT = "ERROR";
        } else {
            RESULT = ts.obtenerTipo(id);
        }
    :}
    | CONST_INT
    {: RESULT = "Integer"; :}
    | CONST_REAL
    {: RESULT = "Float"; :}
    | CONST_STRING
    {: RESULT = "String"; :}
    | PAR_A expresion:e PAR_C
    {: RESULT = e; :}
    ;