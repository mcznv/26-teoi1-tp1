# ====================================================================
# ARCHIVOS GENERADOS POR COMPILACIÓN (MAVEN / JAVA)
# ====================================================================
# Excluye la carpeta de salida de Maven donde se compila todo el proyecto
target/
*.class
*.war
*.ear
*.nar
*.car
*.jack
*.jpi

# Archivos de bitácora y volcados de memoria
*.log
*.dump
*.crash

# ====================================================================
# CÓDIGO GENERADO AUTOMÁTICAMENTE (JFLEX / CUP)
# ====================================================================
# Evita subir los archivos .java que JFlex y CUP generan en cada compilación
# Nota: Modifica el paquete de destino si tus clases generadas usan rutas específicas.
src/main/java/**/*Lexer.java
src/main/java/**/*sym.java
src/main/java/**/*parser.java

